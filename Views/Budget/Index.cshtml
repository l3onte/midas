@model IEnumerable<midasMVC.Models.Budget>

@{
    ViewData["Title"] = "Administración de Presupuestos";
}

<div class="flex h-full min-h-0 w-full flex-col overflow-hidden">

    <div class="
        flex
        flex-shrink-0
        flex-col
        gap-3
        pb-4
        lg:flex-row
        lg:items-center
        lg:justify-between
    ">

        <div class="min-w-0">

            <h2 class="
                m-0
                text-xl
                font-bold
                tracking-tight
                text-[#f8ebca]
                sm:text-2xl
            ">
                Administración de Presupuestos
            </h2>

            <p class="
                mt-1
                mb-0
                text-xs
                text-[#c3b18e]
            ">
                Consulta y administra tus presupuestos financieros.
            </p>

        </div>

        <div class="
            flex
            w-full
            flex-col
            gap-2
            sm:flex-row
            lg:w-auto
        ">

            <div class="
                flex
                h-10
                min-w-0
                w-full
                items-center
                rounded-lg
                border
                border-white/10
                bg-white/10
                px-3
                sm:w-[280px]
            ">

                <i class="
                    fa-solid
                    fa-magnifying-glass
                    mr-2
                    text-xs
                    text-white/50
                "></i>

                <input
                    type="text"
                    id="inputBuscar"
                    class="
                        w-full
                        min-w-0
                        border-0
                        bg-transparent
                        text-xs
                        text-white
                        outline-none
                        placeholder:text-white/50
                    "
                    placeholder="Buscar presupuesto..." />

            </div>

            <button
                type="button"
                class="
                    inline-flex
                    h-10
                    items-center
                    justify-center
                    gap-2
                    rounded-lg
                    border
                    border-[#e0ba5e]/40
                    bg-[#c79a3f]
                    px-4
                    text-xs
                    font-semibold
                    text-white
                    shadow-lg
                    transition
                    duration-200
                    hover:bg-[#b38732]
                    hover:shadow-xl
                "
                data-bs-toggle="modal"
                data-bs-target="#modalAgregarPresupuesto">

                <i class="fa-solid fa-plus text-[11px]"></i>

                <span>Agregar Presupuesto</span>

            </button>

        </div>

    </div>


    <div class="
        min-h-0
        flex-1
        overflow-hidden
        rounded-2xl
        border
        border-white/10
        bg-[#fffaf0]
        shadow-xl
    ">

        <div class="h-full w-full overflow-auto">

            <table class="
                m-0
                min-w-[900px]
                w-full
                align-middle
                text-xs
            ">

                <thead class="
                    sticky
                    top-0
                    z-10
                    bg-[#ead9ae]
                ">

                    <tr class="border-b border-[#d7c59f]">

                        <th class="
                            whitespace-nowrap
                            px-4
                            py-3
                            text-left
                            font-bold
                            text-[#4c381d]
                        ">
                            Id
                        </th>

                        <th class="
                            whitespace-nowrap
                            px-4
                            py-3
                            text-left
                            font-bold
                            text-[#4c381d]
                        ">
                            Categoría
                        </th>

                        <th class="
                            whitespace-nowrap
                            px-4
                            py-3
                            text-left
                            font-bold
                            text-[#4c381d]
                        ">
                            Presupuesto
                        </th>

                        <th class="
                            whitespace-nowrap
                            px-4
                            py-3
                            text-left
                            font-bold
                            text-[#4c381d]
                        ">
                            Fecha Inicial
                        </th>

                        <th class="
                            whitespace-nowrap
                            px-4
                            py-3
                            text-left
                            font-bold
                            text-[#4c381d]
                        ">
                            Fecha Final
                        </th>

                        <th class="
                            whitespace-nowrap
                            px-4
                            py-3
                            text-left
                            font-bold
                            text-[#4c381d]
                        ">
                            Estado
                        </th>

                        <th class="
                            whitespace-nowrap
                            px-4
                            py-3
                            text-center
                            font-bold
                            text-[#4c381d]
                        ">
                            Acciones
                        </th>

                    </tr>

                </thead>


                <tbody>

                    @if (Model != null && Model.Any())
                    {
                        @foreach (var budget in Model)
                        {
                            <tr class="
                                border-b
                                border-[#eee3ce]
                                bg-[#fffaf0]
                                transition
                                duration-150
                                hover:bg-[#f8efd9]
                            ">

                                <td class="
                                    whitespace-nowrap
                                    px-4
                                    py-3
                                    font-medium
                                    text-[#5a4525]
                                ">
                                    @budget.Id
                                </td>


                                <td class="
                                    max-w-[220px]
                                    px-4
                                    py-3
                                    text-[#4d3a20]
                                ">

                                    <div class="truncate font-medium">
                                        @(budget.MovementCategory?.Name ?? "N/A")
                                    </div>

                                </td>


                                <td class="
                                    whitespace-nowrap
                                    px-4
                                    py-3
                                    font-bold
                                    text-[#4c381d]
                                ">

                                    $
                                    @budget.Amount.ToString(
                                        "N2",
                                        new System.Globalization.CultureInfo("en-US")
                                    )

                                    <span class="
                                        text-[10px]
                                        font-medium
                                        text-[#977d4e]
                                    ">
                                        USD
                                    </span>

                                </td>


                                <td class="
                                    whitespace-nowrap
                                    px-4
                                    py-3
                                    text-[#6f5a35]
                                ">
                                    @budget.StartDate.ToString("dd/MM/yyyy")
                                </td>


                                <td class="
                                    whitespace-nowrap
                                    px-4
                                    py-3
                                    text-[#6f5a35]
                                ">
                                    @budget.EndDate.ToString("dd/MM/yyyy")
                                </td>


                                <td class="px-4 py-3">

                                    @if (budget.Status)
                                    {
                                        <span class="
                                            inline-flex
                                            items-center
                                            rounded-full
                                            bg-emerald-100
                                            px-2.5
                                            py-1
                                            text-[10px]
                                            font-bold
                                            text-emerald-700
                                        ">

                                            <span class="
                                                mr-1.5
                                                h-1.5
                                                w-1.5
                                                rounded-full
                                                bg-emerald-500
                                            "></span>

                                            Activo

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="
                                            inline-flex
                                            items-center
                                            rounded-full
                                            bg-red-100
                                            px-2.5
                                            py-1
                                            text-[10px]
                                            font-bold
                                            text-red-700
                                        ">

                                            <span class="
                                                mr-1.5
                                                h-1.5
                                                w-1.5
                                                rounded-full
                                                bg-red-500
                                            "></span>

                                            Inactivo

                                        </span>
                                    }

                                </td>


                                <td class="px-4 py-3">

                                    <div class="
                                        flex
                                        items-center
                                        justify-center
                                        gap-1
                                    ">

                                        <button
                                            type="button"
                                            title="Ver presupuesto"
                                            class="
                                                h-8
                                                w-8
                                                rounded-md
                                                text-[#806634]
                                                transition
                                                hover:bg-[#f3ead7]
                                                hover:text-[#b38732]
                                            ">

                                            <i class="fa-solid fa-eye text-xs"></i>

                                        </button>


                                        <button 
                                            type="button" 
                                            title="Editar presupuesto"
                                            data-bs-toggle="modal"
                                            data-bs-target="#modalEditarPresupuesto"
                                            data-budget-id="@budget.Id"
                                            data-category-id="@budget.CategoryId"
                                            data-amount="@budget.Amount.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                            data-start-date="@budget.StartDate.ToString("yyyy-MM-dd")"
                                            data-end-date="@budget.EndDate.ToString("yyyy-MM-dd")"
                                            class="
                                                h-8
                                                w-8
                                                rounded-md
                                                text-[#806634]
                                                transition
                                                hover:bg-[#f3ead7]
                                                hover:text-[#b38732]
                                            ">
                                            <i class="fa-solid fa-pen text-xs"></i>
                                        </button>


                                        <button
                                            type="button"
                                            title="Eliminar presupuesto"
                                            class="
                                                h-8
                                                w-8
                                                rounded-md
                                                text-[#806634]
                                                transition
                                                hover:bg-red-50
                                                hover:text-red-600
                                            ">

                                            <i class="fa-solid fa-trash text-xs"></i>

                                        </button>

                                    </div>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>

                            <td
                                colspan="7"
                                class="
                                    px-6
                                    py-14
                                    text-center
                                ">

                                <div class="
                                    flex
                                    flex-col
                                    items-center
                                    justify-center
                                ">

                                    <div class="
                                        mb-4
                                        flex
                                        h-14
                                        w-14
                                        items-center
                                        justify-center
                                        rounded-full
                                        bg-[#f3ead7]
                                        text-[#977d4e]
                                    ">

                                        <i class="
                                            fa-solid
                                            fa-wallet
                                            text-xl
                                        "></i>

                                    </div>

                                    <h4 class="
                                        text-sm
                                        font-semibold
                                        text-[#5a4525]
                                    ">
                                        No hay presupuestos registrados
                                    </h4>

                                    <p class="
                                        mt-1
                                        max-w-sm
                                        text-xs
                                        text-[#977d4e]
                                    ">
                                        Todavía no tienes presupuestos disponibles.
                                    </p>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>

<div 
    class="modal fade" 
    id="modalAgregarPresupuesto" 
    tabindex="-1" 
    aria-labelledby="modalAgregarPresupuestoLabel" 
    aria-hidden="true"
>
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content overflow-hidden rounded-2xl border-0 shadow-2xl">

            <div class="bg-[#4a3a20] px-6 py-5">

                <div class="flex items-center justify-between">

                    <div>
                        <h5 
                            class="m-0 text-lg font-bold text-[#f8ebca]"
                            id="modalAgregarPresupuestoLabel"
                        >
                            Agregar Presupuesto
                        </h5>

                        <p class="mt-1 mb-0 text-xs text-[#c3b18e]">
                            Define un límite de gasto para una categoría.
                        </p>
                    </div>

                    <button
                        type="button"
                        class="text-xl text-white/60 transition hover:text-white"
                        data-bs-dismiss="modal"
                        aria-label="Cerrar"
                    >
                        <i class="fa-solid fa-xmark"></i>
                    </button>

                </div>

            </div>


            <form 
                asp-controller="Budget" 
                asp-action="Create" 
                method="post"
            >

                @Html.AntiForgeryToken()

                <div class="space-y-4 bg-[#fffaf0] px-6 py-6">

                    <div>
                        <label 
                            for="CategoryId"
                            class="mb-1.5 block text-xs font-semibold text-[#5a4525]"
                        >
                            Categoría
                        </label>

                        <select
                            id="CategoryId"
                            name="CategoryId"
                            required
                            class="
                                w-full
                                rounded-lg
                                border
                                border-[#d7c59f]
                                bg-white
                                px-3
                                py-2.5
                                text-xs
                                text-[#4d3a20]
                                outline-none
                                transition
                                focus:border-[#c79a3f]
                                focus:ring-2
                                focus:ring-[#c79a3f]/20
                            "
                        >
                            <option value="">
                                Selecciona una categoría
                            </option>

                            @foreach (var category in ViewBag.Categories)
                            {
                                <option value="@category.Id">
                                    @category.Name
                                </option>
                            }
                        </select>
                    </div>


                    <div>
                        <label 
                            for="Amount"
                            class="mb-1.5 block text-xs font-semibold text-[#5a4525]"
                        >
                            Monto del presupuesto
                        </label>

                        <div class="relative">

                            <span 
                                class="
                                    absolute
                                    left-3
                                    top-1/2
                                    -translate-y-1/2
                                    text-xs
                                    font-semibold
                                    text-[#977d4e]
                                "
                            >
                                $
                            </span>

                            <input
                                type="number"
                                id="Amount"
                                name="Amount"
                                min="0.01"
                                step="0.01"
                                required
                                placeholder="0.00"
                                class="
                                    w-full
                                    rounded-lg
                                    border
                                    border-[#d7c59f]
                                    bg-white
                                    py-2.5
                                    pl-7
                                    pr-3
                                    text-xs
                                    text-[#4d3a20]
                                    outline-none
                                    transition
                                    focus:border-[#c79a3f]
                                    focus:ring-2
                                    focus:ring-[#c79a3f]/20
                                "
                            />

                        </div>
                    </div>


                    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">

                        <div>
                            <label 
                                for="StartDate"
                                class="mb-1.5 block text-xs font-semibold text-[#5a4525]"
                            >
                                Fecha inicial
                            </label>

                            <input
                                type="date"
                                id="StartDate"
                                name="StartDate"
                                required
                                class="
                                    w-full
                                    rounded-lg
                                    border
                                    border-[#d7c59f]
                                    bg-white
                                    px-3
                                    py-2.5
                                    text-xs
                                    text-[#4d3a20]
                                    outline-none
                                    transition
                                    focus:border-[#c79a3f]
                                    focus:ring-2
                                    focus:ring-[#c79a3f]/20
                                "
                            />
                        </div>


                        <div>
                            <label 
                                for="EndDate"
                                class="mb-1.5 block text-xs font-semibold text-[#5a4525]"
                            >
                                Fecha final
                            </label>

                            <input
                                type="date"
                                id="EndDate"
                                name="EndDate"
                                required
                                class="
                                    w-full
                                    rounded-lg
                                    border
                                    border-[#d7c59f]
                                    bg-white
                                    px-3
                                    py-2.5
                                    text-xs
                                    text-[#4d3a20]
                                    outline-none
                                    transition
                                    focus:border-[#c79a3f]
                                    focus:ring-2
                                    focus:ring-[#c79a3f]/20
                                "
                            />
                        </div>

                    </div>


                    <div 
                        class="
                            rounded-lg
                            border
                            border-[#e5d7b9]
                            bg-[#f8efd9]
                            px-3
                            py-2.5
                        "
                    >
                        <div class="flex items-start gap-2">

                            <i 
                                class="
                                    fa-solid
                                    fa-circle-info
                                    mt-0.5
                                    text-xs
                                    text-[#b38732]
                                "
                            ></i>

                            <p class="m-0 text-[11px] leading-relaxed text-[#806634]">
                                El presupuesto se aplicará únicamente durante el
                                período seleccionado y sobre los gastos de la
                                categoría indicada.
                            </p>

                        </div>
                    </div>

                </div>


                <div 
                    class="
                        flex
                        items-center
                        justify-end
                        gap-2
                        border-t
                        border-[#eee3ce]
                        bg-[#fffaf0]
                        px-6
                        py-4
                    "
                >

                    <button
                        type="button"
                        data-bs-dismiss="modal"
                        class="
                            h-9
                            rounded-lg
                            border
                            border-[#d7c59f]
                            bg-white
                            px-4
                            text-xs
                            font-semibold
                            text-[#806634]
                            transition
                            hover:bg-[#f8efd9]
                        "
                    >
                        Cancelar
                    </button>

                    <button
                        type="submit"
                        class="
                            inline-flex
                            h-9
                            items-center
                            gap-2
                            rounded-lg
                            border
                            border-[#e0ba5e]/40
                            bg-[#c79a3f]
                            px-4
                            text-xs
                            font-semibold
                            text-white
                            shadow-lg
                            transition
                            hover:bg-[#b38732]
                        "
                    >
                        <i class="fa-solid fa-plus text-[10px]"></i>
                        Crear presupuesto
                    </button>

                </div>

            </form>

        </div>
    </div>
</div>

<div 
    class="modal fade" 
    id="modalEditarPresupuesto" 
    tabindex="-1" 
    aria-labelledby="modalEditarPresupuestoLabel" 
    aria-hidden="true"
>
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content overflow-hidden rounded-2xl border-0 shadow-2xl">

            <div class="bg-[#4a3a20] px-6 py-5">

                <div class="flex items-center justify-between">

                    <div>
                        <h5
                            class="m-0 text-lg font-bold text-[#f8ebca]"
                            id="modalEditarPresupuestoLabel"
                        >
                            Editar Presupuesto
                        </h5>

                        <p class="mt-1 mb-0 text-xs text-[#c3b18e]">
                            Modifica la información de tu presupuesto.
                        </p>
                    </div>

                    <button
                        type="button"
                        class="text-xl text-white/60 transition hover:text-white"
                        data-bs-dismiss="modal"
                        aria-label="Cerrar"
                    >
                        <i class="fa-solid fa-xmark"></i>
                    </button>

                </div>

            </div>


            <form
                asp-controller="Budget"
                asp-action="Update"
                method="post"
            >

                @Html.AntiForgeryToken()

                <input 
                    type="hidden" 
                    id="EditarBudgetId" 
                    name="budgetId"
                />

                <div class="space-y-4 bg-[#fffaf0] px-6 py-6">

                    <div>
                        <label
                            for="EditarCategoryId"
                            class="mb-1.5 block text-xs font-semibold text-[#5a4525]"
                        >
                            Categoría
                        </label>

                        <select
                            id="EditarCategoryId"
                            name="CategoryId"
                            required
                            class="
                                w-full
                                rounded-lg
                                border
                                border-[#d7c59f]
                                bg-white
                                px-3
                                py-2.5
                                text-xs
                                text-[#4d3a20]
                                outline-none
                                transition
                                focus:border-[#c79a3f]
                                focus:ring-2
                                focus:ring-[#c79a3f]/20
                            "
                        >
                            <option value="">
                                Selecciona una categoría
                            </option>

                            @foreach (var category in ViewBag.Categories)
                            {
                                <option value="@category.Id">
                                    @category.Name
                                </option>
                            }

                        </select>
                    </div>


                    <div>
                        <label
                            for="EditarAmount"
                            class="mb-1.5 block text-xs font-semibold text-[#5a4525]"
                        >
                            Monto del presupuesto
                        </label>

                        <div class="relative">

                            <span
                                class="
                                    absolute
                                    left-3
                                    top-1/2
                                    -translate-y-1/2
                                    text-xs
                                    font-semibold
                                    text-[#977d4e]
                                "
                            >
                                $
                            </span>

                            <input
                                type="number"
                                id="EditarAmount"
                                name="Amount"
                                min="0.01"
                                step="0.01"
                                required
                                class="
                                    w-full
                                    rounded-lg
                                    border
                                    border-[#d7c59f]
                                    bg-white
                                    py-2.5
                                    pl-7
                                    pr-3
                                    text-xs
                                    text-[#4d3a20]
                                    outline-none
                                    transition
                                    focus:border-[#c79a3f]
                                    focus:ring-2
                                    focus:ring-[#c79a3f]/20
                                "
                            />

                        </div>
                    </div>


                    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">

                        <div>
                            <label
                                for="EditarStartDate"
                                class="mb-1.5 block text-xs font-semibold text-[#5a4525]"
                            >
                                Fecha inicial
                            </label>

                            <input
                                type="date"
                                id="EditarStartDate"
                                name="StartDate"
                                required
                                class="
                                    w-full
                                    rounded-lg
                                    border
                                    border-[#d7c59f]
                                    bg-white
                                    px-3
                                    py-2.5
                                    text-xs
                                    text-[#4d3a20]
                                    outline-none
                                    transition
                                    focus:border-[#c79a3f]
                                    focus:ring-2
                                    focus:ring-[#c79a3f]/20
                                "
                            />
                        </div>


                        <div>
                            <label
                                for="EditarEndDate"
                                class="mb-1.5 block text-xs font-semibold text-[#5a4525]"
                            >
                                Fecha final
                            </label>

                            <input
                                type="date"
                                id="EditarEndDate"
                                name="EndDate"
                                required
                                class="
                                    w-full
                                    rounded-lg
                                    border
                                    border-[#d7c59f]
                                    bg-white
                                    px-3
                                    py-2.5
                                    text-xs
                                    text-[#4d3a20]
                                    outline-none
                                    transition
                                    focus:border-[#c79a3f]
                                    focus:ring-2
                                    focus:ring-[#c79a3f]/20
                                "
                            />
                        </div>

                    </div>

                </div>


                <div
                    class="
                        flex
                        items-center
                        justify-end
                        gap-2
                        border-t
                        border-[#eee3ce]
                        bg-[#fffaf0]
                        px-6
                        py-4
                    "
                >

                    <button
                        type="button"
                        data-bs-dismiss="modal"
                        class="
                            h-9
                            rounded-lg
                            border
                            border-[#d7c59f]
                            bg-white
                            px-4
                            text-xs
                            font-semibold
                            text-[#806634]
                            transition
                            hover:bg-[#f8efd9]
                        "
                    >
                        Cancelar
                    </button>

                    <button
                        type="submit"
                        class="
                            inline-flex
                            h-9
                            items-center
                            gap-2
                            rounded-lg
                            border
                            border-[#e0ba5e]/40
                            bg-[#c79a3f]
                            px-4
                            text-xs
                            font-semibold
                            text-white
                            shadow-lg
                            transition
                            hover:bg-[#b38732]
                        "
                    >
                        <i class="fa-solid fa-floppy-disk text-[10px]"></i>
                        Guardar cambios
                    </button>

                </div>

            </form>

        </div>
    </div>
</div>

@section Scripts {

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const inputBuscar =
                document.getElementById("inputBuscar");

            const filasTabla =
                document.querySelectorAll("tbody tr");

            if (inputBuscar) {

                inputBuscar.addEventListener(
                    "input",
                    function () {

                        const criterio =
                            this.value
                                .toLowerCase()
                                .trim();

                        filasTabla.forEach(fila => {

                            const textoFila =
                                fila.textContent
                                    .toLowerCase();

                            fila.style.display =
                                textoFila.includes(criterio)
                                    ? ""
                                    : "none";

                        });

                    }
                );

            }

        });
    </script>

    <script>
        const modalEditarPresupuesto =
            document.getElementById("modalEditarPresupuesto");

        if (modalEditarPresupuesto) {

            modalEditarPresupuesto.addEventListener(
                "show.bs.modal",
                function (event) {

                    const button = event.relatedTarget;

                    const budgetId =
                        button.getAttribute("data-budget-id");

                    const categoryId =
                        button.getAttribute("data-category-id");

                    const amount =
                        button.getAttribute("data-amount");

                    const startDate =
                        button.getAttribute("data-start-date");

                    const endDate =
                        button.getAttribute("data-end-date");


                    document.getElementById("EditarBudgetId").value =
                        budgetId;

                    document.getElementById("EditarCategoryId").value =
                        categoryId;

                    document.getElementById("EditarAmount").value =
                        amount;

                    document.getElementById("EditarStartDate").value =
                        startDate;

                    document.getElementById("EditarEndDate").value =
                        endDate;
                }
            );

        }
    </script>

}