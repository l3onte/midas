@model midasMVC.Models.ViewModels.LoginViewModel 
@{
    ViewData["Title"] = "Ingresar";
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Ingresar - Midas Finanzas</title>
    
    <link rel="icon"
        type="image/png"
        href="~/images/MIDAS_Logo.png" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
</head>
<body>
<div class="login-page">
    <section class="login-hero">
        <div class="hero-overlay">

            <div class="hero-main">

                <div class="hero-badge">
                    <span class="hero-badge-dot"></span>
                    MIDAS FINANZAS
                </div>

                <h2>
                    Midas<span>.</span>
                </h2>

                <p class="hero-description">
                    Toma el control de tus finanzas y convierte tus objetivos
                    en decisiones inteligentes.
                </p>

                <div class="hero-features">

                    <div class="hero-feature">
                        <span class="feature-icon">↗</span>
                        <div>
                            <strong>Ingresos</strong>
                            <small>Controlados</small>
                        </div>
                    </div>

                    <div class="hero-feature">
                        <span class="feature-icon">−</span>
                        <div>
                            <strong>Gastos</strong>
                            <small>Organizados</small>
                        </div>
                    </div>

                    <div class="hero-feature">
                        <span class="feature-icon">◇</span>
                        <div>
                            <strong>Metas</strong>
                            <small>En camino</small>
                        </div>
                    </div>

                </div>

            </div>

            <div class="hero-bottom">

                <div class="hero-glass-card">
                    <div class="glass-card-icon">
                        $
                    </div>

                    <div class="glass-card-content">
                        <span>Tu dinero, bajo control</span>
                        <strong>+24.8%</strong>
                        <small>mejor organización financiera</small>
                    </div>

                    <div class="glass-card-chart">
                        <span></span>
                        <span></span>
                        <span></span>
                        <span></span>
                        <span></span>
                        <span></span>
                    </div>
                </div>

                <div class="hero-footer-text">
                    <span></span>
                    Tu resumen financiero, siempre contigo.
                </div>

            </div>

        </div>
    </section>

    <section class="login-panel">
        <div class="login-box">
            <h1>Bienvenido de nuevo</h1>
            <p class="subtitle">Inicia sesión para gestionar tus finanzas personales.</p>
            <form asp-action="Login" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                
                <div class="mb-3">
                    <label asp-for="Email" class="form-label">Correo electrónico</label>
                    <input asp-for="Email" class="form-control form-control-lg" autocomplete="username" placeholder="ejemplo@correo.com" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                
                <div class="mb-3">
                    <label asp-for="Password" class="form-label">Contraseña</label>
                    <input asp-for="Password" class="form-control form-control-lg" autocomplete="current-password" placeholder="••••••••" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
                
                <div class="form-check mb-4">
                    <input asp-for="RememberMe" class="form-check-input" />
                    <label asp-for="RememberMe" class="form-check-label">Recordar mi sesión</label>
                </div>
                
                <button class="btn btn-primary w-100 btn-lg" type="submit">
                    Iniciar Sesión
                </button>

                <div class="mt-3 text-center">

                    <span
                        class="d-block mb-2 small"
                        style="color: #b8b8b8;"
                    >
                        ¿Todavía no tienes una cuenta?
                    </span>

                    <a
                        asp-controller="Cuenta"
                        asp-action="Register"
                        class="
                            d-inline-flex
                            align-items-center
                            justify-content-center
                            gap-2
                            w-100
                            btn
                            btn-outline-secondary
                            btn-lg
                            text-decoration-none
                        "
                        style="
                            border-color: #c79a3f;
                            color: #806634;
                        "
                    >
                        <i class="fa-solid fa-user-plus"></i>
                        Crear una cuenta
                    </a>

                </div>
            </form>
        </div>
    </section>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>

</body>
</html>