@{
    ViewData["Title"] = "Suscripción confirmada";
}

<div class="flex min-h-full items-center justify-center px-6 py-10">
    <div class="w-full max-w-md rounded-2xl border border-[#dfbd67]/20 bg-white/[0.035] p-8 text-center shadow-2xl backdrop-blur-xl">

        <div class="mx-auto mb-5 flex h-16 w-16 items-center justify-center rounded-full bg-[#dfbd67]/10">
            <i class="fa-solid fa-check text-2xl text-[#e8c978]"></i>
        </div>

        <h1 class="text-2xl font-bold text-[#fffaf0]">
            ¡Suscripción confirmada!
        </h1>

        <p class="mt-3 text-sm leading-relaxed text-[#b8aa91]">
            Tu suscripción Premium ha sido activada correctamente.
        </p>

        <a asp-controller="Home"
           asp-action="Index"
           class="mt-6 inline-flex h-10 items-center justify-center rounded-lg bg-gradient-to-r from-[#b4872f] via-[#dfbd67] to-[#f0c967] px-6 text-sm font-bold text-[#17130b] transition hover:-translate-y-0.5">
            Ir al inicio
        </a>

    </div>
</div>