@{
ViewData["Title"] = "Pasar a Premium";
}

<div class="relative flex  w-full items-center justify-center overflow-hidden">
    <div class="pointer-events-none absolute left-1/2 top-1/2 h-72 w-72 -translate-x-1/2 -translate-y-1/2 rounded-full bg-[#c99e42]/5 blur-[100px]"></div>

    <div class="relative z-10 flex w-full max-w-5xl flex-col justify-center ">

        <div class="shrink-0 text-center">

            <div class="mb-1.5 flex items-center justify-center gap-2 text-[9px] font-bold uppercase tracking-[0.28em] text-[#dfbd67]">
                <i class="fa-solid fa-crown text-[9px]"></i>
                <span>Pasar a Premium</span>
            </div>

            <h1 class="text-2xl font-bold tracking-tight text-[#fff7e5] sm:text-3xl">
                Selecciona el plan ideal para ti
            </h1>

            <p class="mx-auto mt-1 max-w-xl text-[11px] leading-relaxed text-[#a99a7d]">
                Desbloquea todas las funciones de Midas y lleva el control de tus finanzas al siguiente nivel.
            </p>

        </div>

        <div class=" grid min-h-0 grid-cols-1 gap-4 lg:grid-cols-2">

            <div class="relative overflow-hidden rounded-[24px] border border-white/10 bg-white/[0.045] p-5 shadow-[0_20px_60px_rgba(0,0,0,0.35)] backdrop-blur-2xl">

                <div class="pointer-events-none absolute inset-0 rounded-[24px] bg-gradient-to-br from-white/[0.07] via-transparent to-[#dfbd67]/[0.035]"></div>

                <div class="relative">

                    <div class="flex items-start justify-between">

                        <div class="flex h-10 w-10 items-center justify-center rounded-xl border border-[#dfbd67]/20 bg-[#dfbd67]/10 text-[#f0c967]">
                            <i class="fa-solid fa-crown text-sm"></i>
                        </div>

                    </div>

                    <div class="mt-3">

                        <h2 class="text-lg font-bold text-[#fff5dc]">
                            Premium Mensual
                        </h2>

                        <p class="mt-0.5 text-[10px] text-[#a99a7d]">
                            Flexibilidad para disfrutar Premium mes a mes.
                        </p>

                    </div>

                    <div class="mt-3 flex items-end gap-1.5">

                        <span class="text-3xl font-bold tracking-tight text-[#fff8e8]">
                            $9.99
                        </span>

                        <span class="mb-1 text-xs text-[#dfbd67]">
                            /mes
                        </span>

                    </div>

                    <div class="my-3.5 h-px bg-gradient-to-r from-[#dfbd67]/20 via-white/10 to-transparent"></div>

                    <div class="space-y-2">

                        <div class="flex items-center gap-2.5">

                            <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-[#dfbd67]/15 text-[#dfbd67]">
                                <i class="fa-solid fa-check text-[8px]"></i>
                            </span>

                            <span class="text-[10px] text-[#d8ccb5]">
                                Acceso completo a todas las funciones
                            </span>

                        </div>

                        <div class="flex items-center gap-2.5">

                            <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-[#dfbd67]/15 text-[#dfbd67]">
                                <i class="fa-solid fa-check text-[8px]"></i>
                            </span>

                            <span class="text-[10px] text-[#d8ccb5]">
                                Soporte prioritario
                            </span>

                        </div>

                        <div class="flex items-center gap-2.5">

                            <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-[#dfbd67]/15 text-[#dfbd67]">
                                <i class="fa-solid fa-check text-[8px]"></i>
                            </span>

                            <span class="text-[10px] text-[#d8ccb5]">
                                Sin anuncios
                            </span>

                        </div>

                        <div class="flex items-center gap-2.5">

                            <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-[#dfbd67]/15 text-[#dfbd67]">
                                <i class="fa-solid fa-check text-[8px]"></i>
                            </span>

                            <span class="text-[10px] text-[#d8ccb5]">
                                Cancela cuando quieras
                            </span>

                        </div>

                    </div>

                    <button type="button"
                            class="group mt-4 flex w-full items-center justify-center gap-2 rounded-xl border border-[#dfbd67]/30 bg-[#dfbd67]/10 px-4 py-2.5 text-[10px] font-bold text-[#f1d48b] backdrop-blur-xl transition-all duration-300 hover:border-[#dfbd67]/60 hover:bg-[#dfbd67]/20 hover:shadow-[0_8px_25px_rgba(223,189,103,0.15)]">

                        <span>
                            Seleccionar plan
                        </span>

                        <i class="fa-solid fa-arrow-right text-[8px] transition-transform duration-300 group-hover:translate-x-1"></i>

                    </button>

                </div>

            </div>

            <div class="relative overflow-visible rounded-[24px] border border-[#dfbd67]/65 bg-gradient-to-br from-[#dfbd67]/15 via-white/[0.05] to-[#8d6a28]/10 p-5 shadow-[0_0_35px_rgba(223,189,103,0.14),0_20px_60px_rgba(0,0,0,0.4)] backdrop-blur-2xl">

                <div class="pointer-events-none absolute inset-0 overflow-hidden rounded-[24px]">

                    <div class="absolute -right-16 -top-16 h-36 w-36 rounded-full bg-[#dfbd67]/10 blur-3xl"></div>

                    <div class="absolute -bottom-10 -left-10 h-28 w-28 rounded-full bg-[#c99e42]/10 blur-3xl"></div>

                </div>

                <div class="absolute -top-2.5 right-5 rounded-full border border-[#f0c967]/50 bg-gradient-to-r from-[#e7b94f] to-[#c99e42] px-3 py-1 text-[8px] font-extrabold uppercase tracking-wide text-[#30230f] shadow-[0_4px_15px_rgba(223,189,103,0.3)]">
                    Más popular
                </div>

                <div class="relative">

                    <div class="flex h-10 w-10 items-center justify-center rounded-xl border border-[#dfbd67]/30 bg-[#dfbd67]/15 text-[#ffe39a] shadow-[0_6px_25px_rgba(223,189,103,0.15)]">
                        <i class="fa-solid fa-crown text-sm"></i>
                    </div>

                    <div class="mt-3">

                        <h2 class="text-lg font-bold text-[#fff8e8]">
                            Premium Anual
                        </h2>

                        <p class="mt-0.5 text-[10px] text-[#c8b99b]">
                            La mejor opción para disfrutar Midas todo el año.
                        </p>

                    </div>

                    <div class="mt-3 flex items-end gap-1.5">

                        <span class="text-3xl font-bold tracking-tight text-[#fff8e8]">
                            $79.99
                        </span>

                        <span class="mb-1 text-xs text-[#dfbd67]">
                            /año
                        </span>

                    </div>

                    <div class="mt-1.5 inline-flex items-center rounded-full border border-[#dfbd67]/30 bg-[#dfbd67]/10 px-2 py-0.5 text-[8px] font-bold text-[#f1d48b]">
                        Ahorras 33%
                    </div>

                    <div class="my-3 h-px bg-gradient-to-r from-[#dfbd67]/40 via-white/10 to-transparent"></div>

                    <div class="space-y-2">

                        <div class="flex items-center gap-2.5">

                            <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-[#dfbd67]/20 text-[#f5d37c]">
                                <i class="fa-solid fa-check text-[8px]"></i>
                            </span>

                            <span class="text-[10px] text-[#eee2c9]">
                                Acceso completo a todas las funciones
                            </span>

                        </div>

                        <div class="flex items-center gap-2.5">

                            <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-[#dfbd67]/20 text-[#f5d37c]">
                                <i class="fa-solid fa-check text-[8px]"></i>
                            </span>

                            <span class="text-[10px] text-[#eee2c9]">
                                Soporte prioritario
                            </span>

                        </div>

                        <div class="flex items-center gap-2.5">

                            <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-[#dfbd67]/20 text-[#f5d37c]">
                                <i class="fa-solid fa-check text-[8px]"></i>
                            </span>

                            <span class="text-[10px] text-[#eee2c9]">
                                Sin anuncios
                            </span>

                        </div>

                        <div class="flex items-center gap-2.5">

                            <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-[#dfbd67]/20 text-[#f5d37c]">
                                <i class="fa-solid fa-check text-[8px]"></i>
                            </span>

                            <span class="text-[10px] text-[#eee2c9]">
                                Cancela cuando quieras
                            </span>

                        </div>

                    </div>

                    <button type="button"
                            class="group mt-4 flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#e5b94f] via-[#d2a64c] to-[#b4872f] px-4 py-2.5 text-[10px] font-extrabold text-[#251b0b] shadow-[0_8px_25px_rgba(223,189,103,0.25)] transition-all duration-300 hover:scale-[1.01] hover:shadow-[0_10px_30px_rgba(223,189,103,0.4)]">

                        <span>
                            Seleccionar plan
                        </span>

                        <i class="fa-solid fa-arrow-right text-[8px] transition-transform duration-300 group-hover:translate-x-1"></i>

                    </button>

                </div>

            </div>

        </div>

        <div class="mt-4 flex shrink-0 items-center justify-center gap-5 text-[8px] text-[#81745e] sm:gap-8">

            <div class="flex items-center gap-1.5">
                <i class="fa-solid fa-shield-halved text-[#dfbd67]"></i>
                <span>Pago seguro</span>
            </div>

            <div class="h-3 w-px bg-white/10"></div>

            <div class="flex items-center gap-1.5">
                <i class="fa-solid fa-rotate text-[#dfbd67]"></i>
                <span>Sin compromiso</span>
            </div>

            <div class="h-3 w-px bg-white/10"></div>

            <div class="flex items-center gap-1.5">
                <i class="fa-solid fa-gem text-[#dfbd67]"></i>
                <span>Experiencia Premium</span>
            </div>

        </div>

    </div>

</div>
