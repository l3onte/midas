@{
 ViewData["Title"] = "Panel principal";
}

<div class="container py-4">
    <h1>Panel principal</h1>
    <p
        envenido, <strong>@User.Identity?.Name</strong>.
    </p>
    <p>
        Rol actual:
        <strong>
            @User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value
        </strong>
    </p>

    <div class="row g-3 mt-3">
        @if (User.IsInRole("Administrador"))
        {
            <div class="col-md-4">
                <a class="btn btn-dark w-100" asp-action="Administracion">
                    Administración
                </a>
            </div>
        }

        @if (User.IsInRole("Usuario Free") ||
        User.IsInRole("Usuario Free"))
        {
            <div class="col-md-4">
                <a class="btn btn-success w-100" asp-action="Free_Version">
                Salud y Reproducción
                </a>
            </div>
        }
        
        @if (User.IsInRole("Usuario Premium") ||
        User.IsInRole("Usuario Premium"))
        {
            <div class="col-md-4">
                <a class="btn btn-primary w-100" asp-action="Premium_Version">
                Operaciones
                </a>
            </div>
        }
    </div>
</div>