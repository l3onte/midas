@using midasMVC.Models

@model IEnumerable<midasMVC.Models.Account>

@{
    ViewData["Title"] = "Mis Cuentas";
}

<div class="flex h-full min-h-0 w-full flex-col overflow-hidden">

    <div class="
        flex
        flex-shrink-0
        flex-col
        gap-3
        pb-4
        lg:flex-row
        lg:items-center
        lg:justify-between
    ">

        <div class="min-w-0">

            <h2 class="
                m-0
                text-xl
                font-bold
                tracking-tight
                text-[#f8ebca]
                sm:text-2xl
            ">
                Mis Cuentas
            </h2>

            <p class="
                mt-1
                mb-0
                text-xs
                text-[#c3b18e]
            ">
                Administra tus cuentas y consulta tus balances.
            </p>

        </div>

        <div class="
            flex
            w-full
            flex-col
            gap-2
            sm:flex-row
            lg:w-auto
        ">

            <div class="
                flex
                h-10
                min-w-0
                w-full
                items-center
                rounded-lg
                border
                border-white/10
                bg-white/10
                px-3
                sm:w-[280px]
            ">

                <i class="
                    fa-solid
                    fa-magnifying-glass
                    mr-2
                    text-xs
                    text-white/50
                "></i>

                <input type="text"
                       id="inputBuscar"
                       class="
                            w-full
                            min-w-0
                            border-0
                            bg-transparent
                            text-xs
                            text-white
                            outline-none
                            placeholder:text-white/50
                       "
                       placeholder="Buscar cuenta..." />

            </div>

            <button type="button"
                    class="
                        inline-flex
                        h-10
                        items-center
                        justify-center
                        gap-2
                        rounded-lg
                        border
                        border-[#e0ba5e]/40
                        bg-[#c79a3f]
                        px-4
                        text-xs
                        font-semibold
                        text-white
                        shadow-lg
                        transition
                        duration-200
                        hover:bg-[#b38732]
                        hover:shadow-xl
                    "
                    data-bs-toggle="modal"
                    data-bs-target="#modalCrearCuenta">

                <i class="fa-solid fa-plus text-[11px]"></i>

                <span>Agregar Cuenta</span>

            </button>

        </div>

    </div>


    <div class="
        min-h-0
        flex-1
        overflow-hidden
        rounded-2xl
        border
        border-white/10
        bg-[#fffaf0]
        shadow-xl
    ">

        <div class="
            h-full
            w-full
            overflow-auto
        ">

            <table class="
                m-0
                min-w-[900px]
                w-full
                align-middle
                text-xs
            ">

                <thead class="
                    sticky
                    top-0
                    z-10
                    bg-[#ead9ae]
                ">

                    <tr class="border-b border-[#d7c59f]">

                        <th class="
                            whitespace-nowrap
                            px-4
                            py-3
                            text-left
                            font-bold
                            text-[#4c381d]
                        ">
                            Id
                        </th>

                        <th class="
                            whitespace-nowrap
                            px-4
                            py-3
                            text-left
                            font-bold
                            text-[#4c381d]
                        ">
                            Nombre
                        </th>

                        <th class="
                            whitespace-nowrap
                            px-4
                            py-3
                            text-left
                            font-bold
                            text-[#4c381d]
                        ">
                            Tipo
                        </th>

                        <th class="
                            whitespace-nowrap
                            px-4
                            py-3
                            text-left
                            font-bold
                            text-[#4c381d]
                        ">
                            Balance
                        </th>

                        <th class="
                            whitespace-nowrap
                            px-4
                            py-3
                            text-left
                            font-bold
                            text-[#4c381d]
                        ">
                            Estado
                        </th>

                        <th class="
                            whitespace-nowrap
                            px-4
                            py-3
                            text-left
                            font-bold
                            text-[#4c381d]
                        ">
                            Acciones
                        </th>

                    </tr>

                </thead>

                <tbody>

                    @if (Model != null && Model.Any())
                    {
                        @foreach (var account in Model)
                        {
                            <tr class="
                                border-b
                                border-[#eee3ce]
                                bg-[#fffaf0]
                                transition
                                duration-150
                                hover:bg-[#f8efd9]
                            ">

                                <td class="
                                    whitespace-nowrap
                                    px-4
                                    py-3
                                    font-medium
                                    text-[#5a4525]
                                ">
                                    @account.Id
                                </td>

                                <td class="
                                    max-w-[240px]
                                    px-4
                                    py-3
                                    font-semibold
                                    text-[#4d3a20]
                                ">
                                    <div class="truncate">
                                        @account.Name
                                    </div>
                                </td>

                                <td class="
                                    whitespace-nowrap
                                    px-4
                                    py-3
                                    text-[#5f4a29]
                                ">
                                    @account.Account_type
                                </td>

                                <td class="
                                    whitespace-nowrap
                                    px-4
                                    py-3
                                    font-bold
                                    text-[#4c381d]
                                ">
                                    @account.Balance.ToString("N2")
                                    <span class="text-[10px] font-medium text-[#977d4e]">
                                        C$
                                    </span>
                                </td>

                                <td class="px-4 py-3">

                                    @if (account.Status)
                                    {
                                        <span class="
                                            inline-flex
                                            items-center
                                            rounded-full
                                            bg-emerald-100
                                            px-2.5
                                            py-1
                                            text-[10px]
                                            font-bold
                                            text-emerald-700
                                        ">

                                            <span class="
                                                mr-1.5
                                                h-1.5
                                                w-1.5
                                                rounded-full
                                                bg-emerald-500
                                            "></span>

                                            Activo

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="
                                            inline-flex
                                            items-center
                                            rounded-full
                                            bg-red-100
                                            px-2.5
                                            py-1
                                            text-[10px]
                                            font-bold
                                            text-red-700
                                        ">

                                            <span class="
                                                mr-1.5
                                                h-1.5
                                                w-1.5
                                                rounded-full
                                                bg-red-500
                                            "></span>

                                            Inactivo

                                        </span>
                                    }

                                </td>

                                <td class="px-4 py-3">

                                    <button type="button"
                                            class="
                                                inline-flex
                                                items-center
                                                gap-1.5
                                                rounded-lg
                                                border
                                                border-[#d7bd83]
                                                bg-[#f5ead3]
                                                px-3
                                                py-2
                                                text-[10px]
                                                font-semibold
                                                text-[#806432]
                                                transition
                                                hover:bg-[#ead9ae]
                                            "
                                            data-bs-toggle="modal"
                                            data-bs-target="#modalEditarCuenta_@account.Id">

                                        <i class="fa-solid fa-pen-to-square"></i>

                                        Editar

                                    </button>

                                </td>

                            </tr>

                            <div class="modal fade"
                                 id="modalEditarCuenta_@account.Id"
                                 tabindex="-1"
                                 aria-labelledby="labelEditar_@account.Id"
                                 aria-hidden="true">

                                <div class="modal-dialog modal-dialog-centered">

                                    <div class="
                                        modal-content
                                        overflow-hidden
                                        rounded-2xl
                                        border-0
                                        bg-[#fffaf0]
                                        shadow-2xl
                                    ">

                                        <form asp-controller="Account"
                                              asp-action="Edit"
                                              method="post">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="accountId"
                                                   value="@account.Id" />

                                            <div class="
                                                modal-header
                                                border-0
                                                bg-gradient-to-r
                                                from-[#b58934]
                                                to-[#d0a74d]
                                                px-5
                                                py-4
                                                text-white
                                            ">

                                                <h5 class="
                                                    modal-title
                                                    text-base
                                                    font-bold
                                                "
                                                    id="labelEditar_@account.Id">

                                                    Editar Cuenta:
                                                    @account.Name

                                                </h5>

                                                <button type="button"
                                                        class="btn-close btn-close-white"
                                                        data-bs-dismiss="modal"
                                                        aria-label="Close">
                                                </button>

                                            </div>

                                            <div class="modal-body p-5">

                                                <div class="mb-3">

                                                    <label class="
                                                        form-label
                                                        mb-2
                                                        text-xs
                                                        font-bold
                                                        text-[#4d3a20]
                                                    ">
                                                        Nombre de la Cuenta
                                                    </label>

                                                    <input type="text"
                                                           name="Name"
                                                           class="form-control rounded-lg border-[#dfd1b7]"
                                                           value="@account.Name"
                                                           required />

                                                </div>

                                                <div class="form-check form-switch mb-3">

                                                    <input class="form-check-input"
                                                           type="checkbox"
                                                           name="Status"
                                                           id="statusCheck_@account.Id"
                                                           value="true"
                                                           @(account.Status ? "checked" : "") />

                                                    <input type="hidden"
                                                           name="Status"
                                                           value="false" />

                                                    <label class="
                                                        form-check-label
                                                        ms-2
                                                        text-xs
                                                        font-semibold
                                                        text-[#5a4525]
                                                    "
                                                           for="statusCheck_@account.Id">

                                                        Cuenta Activa

                                                    </label>

                                                </div>

                                            </div>

                                            <div class="
                                                modal-footer
                                                border-0
                                                bg-[#f8f0df]
                                                px-5
                                                py-4
                                            ">

                                                <button type="button"
                                                        class="
                                                            btn
                                                            rounded-lg
                                                            border-0
                                                            bg-[#e5dcc9]
                                                            px-4
                                                            text-xs
                                                            font-semibold
                                                            text-[#5a4525]
                                                        "
                                                        data-bs-dismiss="modal">

                                                    Cancelar

                                                </button>

                                                <button type="submit"
                                                        class="
                                                            btn
                                                            rounded-lg
                                                            border-0
                                                            bg-[#c79a3f]
                                                            px-4
                                                            text-xs
                                                            font-semibold
                                                            text-white
                                                            shadow
                                                            transition
                                                            hover:bg-[#b38732]
                                                        ">

                                                    <i class="fa-solid fa-check me-1"></i>

                                                    Guardar Cambios

                                                </button>

                                            </div>

                                        </form>

                                    </div>

                                </div>

                            </div>
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="6"
                                class="
                                    px-4
                                    py-10
                                    text-center
                                    text-sm
                                    text-[#8f7a56]
                                ">

                                <div class="flex flex-col items-center">

                                    <div class="
                                        mb-3
                                        flex
                                        h-12
                                        w-12
                                        items-center
                                        justify-center
                                        rounded-full
                                        bg-[#f2e5c7]
                                        text-[#ba8c37]
                                    ">

                                        <i class="fa-solid fa-wallet"></i>

                                    </div>

                                    <span class="font-semibold">
                                        No hay cuentas registradas.
                                    </span>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>


<div class="modal fade"
     id="modalCrearCuenta"
     tabindex="-1"
     aria-labelledby="labelCrearCuenta"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="
            modal-content
            overflow-hidden
            rounded-2xl
            border-0
            bg-[#fffaf0]
            shadow-2xl
        ">

            <form asp-controller="Account"
                  asp-action="Create"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="
                    modal-header
                    border-0
                    bg-gradient-to-r
                    from-[#b58934]
                    to-[#d0a74d]
                    px-5
                    py-4
                    text-white
                ">

                    <h5 class="
                        modal-title
                        flex
                        items-center
                        gap-2
                        text-base
                        font-bold
                    "
                        id="labelCrearCuenta">

                        <i class="fa-solid fa-wallet"></i>

                        Agregar Nueva Cuenta

                    </h5>

                    <button type="button"
                            class="btn-close btn-close-white"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                    </button>

                </div>

                <div class="modal-body p-5">

                    <div class="mb-3">

                        <label class="
                            form-label
                            mb-2
                            text-xs
                            font-bold
                            text-[#4d3a20]
                        ">
                            Nombre de la Cuenta
                        </label>

                        <input type="text"
                               name="Name"
                               class="form-control rounded-lg border-[#dfd1b7]"
                               placeholder="Ej. Cuenta de Ahorro BAC"
                               required />

                    </div>

                    <div class="mb-3">

                        <label class="
                            form-label
                            mb-2
                            text-xs
                            font-bold
                            text-[#4d3a20]
                        ">
                            Tipo de Cuenta
                        </label>

                        <select name="Account_type"
                                class="form-select rounded-lg border-[#dfd1b7]"
                                asp-items="Html.GetEnumSelectList<AccountType>()"
                                required>

                            <option value="">
                                -- Seleccione un tipo --
                            </option>

                        </select>

                    </div>

                    <div class="mb-3">

                        <label class="
                            form-label
                            mb-2
                            text-xs
                            font-bold
                            text-[#4d3a20]
                        ">
                            Balance Inicial
                        </label>

                        <input type="number"
                               step="0.01"
                               name="Balance"
                               class="form-control rounded-lg border-[#dfd1b7]"
                               value="0.00"
                               required />

                    </div>

                    <div class="form-check form-switch mb-3">

                        <input class="form-check-input"
                               type="checkbox"
                               name="Status"
                               id="statusCrear"
                               value="true"
                               checked />

                        <input type="hidden"
                               name="Status"
                               value="false" />

                        <label class="
                            form-check-label
                            ms-2
                            text-xs
                            font-semibold
                            text-[#5a4525]
                        "
                               for="statusCrear">

                            Cuenta Activa

                        </label>

                    </div>

                </div>

                <div class="
                    modal-footer
                    border-0
                    bg-[#f8f0df]
                    px-5
                    py-4
                ">

                    <button type="button"
                            class="
                                btn
                                rounded-lg
                                border-0
                                bg-[#e5dcc9]
                                px-4
                                text-xs
                                font-semibold
                                text-[#5a4525]
                            "
                            data-bs-dismiss="modal">

                        Cancelar

                    </button>

                    <button type="submit"
                            class="
                                btn
                                rounded-lg
                                border-0
                                bg-[#c79a3f]
                                px-4
                                text-xs
                                font-semibold
                                text-white
                                shadow
                                transition
                                hover:bg-[#b38732]
                            ">

                        <i class="fa-solid fa-check me-1"></i>

                        Crear Cuenta

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const inputBuscar =
                document.getElementById("inputBuscar");

            const filasTabla =
                document.querySelectorAll("tbody tr");

            if (inputBuscar) {

                inputBuscar.addEventListener("input", function () {

                    const criterio =
                        this.value
                            .toLowerCase()
                            .trim();

                    filasTabla.forEach(fila => {

                        const textoFila =
                            fila.textContent.toLowerCase();

                        fila.style.display =
                            textoFila.includes(criterio)
                                ? ""
                                : "none";

                    });

                });

            }

        });

    </script>

}