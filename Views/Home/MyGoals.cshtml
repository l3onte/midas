@using midasMVC.Models
@model IEnumerable<midasMVC.Models.Goal>

@{
    ViewData["Title"] = "Mis Metas";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Mis Metas</h2>
    <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#modalCrearMeta">
        <i class="bi bi-plus-circle me-1"></i> Agregar Meta
    </button>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Id</th>
                <th>Nombre</th>
                <th>Monto Objetivo</th>
                <th>Monto Actual</th>
                <th style="width: 20%;">Progreso</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                @foreach (var goal in Model)
                {
                    var porcentaje = goal.Target_amount > 0 
                        ? Math.Min(100, (goal.Current_amount / goal.Target_amount) * 100) 
                        : 0;

                    <tr>
                        <td>@goal.Id</td>
                        <td>@goal.Name</td>
                        <td>$@goal.Target_amount.ToString("N2")</td>
                        <td>$@goal.Current_amount.ToString("N2")</td>
                        <td>
                            <div class="progress" style="height: 20px;">
                                <div class="progress-bar @(porcentaje >= 100 ? "bg-success" : "bg-primary")" 
                                     role="progressbar" 
                                     style="width: @porcentaje.ToString("F0")%;" 
                                     aria-valuenow="@porcentaje" 
                                     aria-valuemin="0" 
                                     aria-valuemax="100">
                                    @porcentaje.ToString("F0")%
                                </div>
                            </div>
                        </td>
                        <td>
                            @if (goal.Status)
                            {
                                <span class="badge bg-success">Activo</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Inactivo</span>
                            }
                        </td>
                        <td>
                            <button type="button" class="btn btn-outline-primary btn-sm" data-bs-toggle="modal" data-bs-target="#modalEditarMeta_@goal.Id">
                                <i class="bi bi-pencil-square me-1"></i> Editar
                            </button>
                        </td>
                    </tr>

                    <!-- Modal Editar Meta -->
                    <div class="modal fade" id="modalEditarMeta_@goal.Id" tabindex="-1" aria-labelledby="labelEditar_@goal.Id" aria-hidden="true">
                        <div class="modal-dialog">
                            <div class="modal-content">
                                <form asp-controller="Meta" asp-action="Update" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="goalId" value="@goal.Id" />
                                    
                                    <div class="modal-header">
                                        <h5 class="modal-title" id="labelEditar_@goal.Id">Editar Meta: @goal.Name</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body">
                                        <div class="mb-3">
                                            <label class="form-label">Nombre de la Meta</label>
                                            <input type="text" name="Name" class="form-control" value="@goal.Name" required />
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">Monto Objetivo ($)</label>
                                            <input type="number" step="0.01" name="Target_amount" class="form-control" value="@goal.Target_amount" required />
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">Monto Actual ($)</label>
                                            <input type="number" step="0.01" name="Current_amount" class="form-control" value="@goal.Current_amount" required />
                                        </div>
                                        <div class="form-check form-switch mb-3">
                                            <input class="form-check-input" type="checkbox" name="Status" id="statusCheck_@goal.Id" value="true" @(goal.Status ? "checked" : "") />
                                            <input type="hidden" name="Status" value="false" />
                                            <label class="form-check-label" for="statusCheck_@goal.Id">Meta Activa</label>
                                        </div>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                                        <button type="submit" class="btn btn-primary">Guardar Cambios</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <tr>
                    <td colspan="7" class="text-center py-3">No hay metas registradas.</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Modal Crear Meta -->
<div class="modal fade" id="modalCrearMeta" tabindex="-1" aria-labelledby="labelCrearMeta" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-controller="Meta" asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title" id="labelCrearMeta">Agregar Nueva Meta</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Nombre de la Meta</label>
                        <input type="text" name="Name" class="form-control" placeholder="Ej. Fondo de Emergencia" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Monto Objetivo ($)</label>
                        <input type="number" step="0.01" name="Target_amount" class="form-control" placeholder="1000.00" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Monto Inicial ($)</label>
                        <input type="number" step="0.01" name="Current_amount" class="form-control" value="0.00" required />
                    </div>
                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" name="Status" id="statusCrear" value="true" checked />
                        <input type="hidden" name="Status" value="false" />
                        <label class="form-check-label" for="statusCrear">Meta Activa</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-success">Crear Meta</button>
                </div>
            </form>
        </div>
    </div>
</div>