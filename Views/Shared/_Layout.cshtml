<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Midas</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/midasMVC.styles.css" asp-append-version="true" />
    <style>
        .app-sidebar {
            width: 260px;
            background-color: #79602b6d; 
            color: #f8fafc;
        }
        .app-sidebar .nav-link {
            color: #94a3b8;
            border-radius: 0.375rem;
            padding: 0.6rem 1rem;
            transition: all 0.2s ease-in-out;
        }
        .app-sidebar .nav-link:hover, 
        .app-sidebar .nav-link.active {
            color: #ffffff;
            background-color: #8d8d42;
        }
        .app-sidebar .brand-text {
            color: #ffffff;
            font-size: 1.5rem;
            letter-spacing: 0.5px;
        }
        @@media (max-width: 767.98px) {
            .app-sidebar {
                width: 100%;
                min-height: auto !important;
            }
        }
    </style>
</head>
<body>
    <div class="d-flex flex-column flex-md-row min-vh-100">
        <aside class="app-sidebar d-flex flex-column justify-content-between p-3 flex-shrink-0">
            <div>
                <div class="d-flex align-items-center mb-4 px-2 pt-2 border-bottom border-secondary pb-3">
                    <a class="brand-text fw-bold text-decoration-none" asp-area="" asp-controller="Home" asp-action="Index">
                        Midas
                    </a>
                </div>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <ul class="nav nav-pills flex-column gap-1">
                        <li class="nav-item">
                            <a class="nav-link text-black" asp-controller="Home" asp-action="Index">
                                Inicio
                            </a>
                        </li>
                    
                        @if (User.IsInRole("Usuario Free") || User.IsInRole("Usuario Premium"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-black" asp-action="Movimientos">
                                    Movimientos
                                </a>
                            </li>
                        
                            <li class="nav-item">
                                <a class="nav-link text-black" asp-action="MovementCategories">
                                    Categorias de Movimientos
                                </a>
                            </li>
                        }

                        @if (User.IsInRole("Administrador"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-black" asp-action="Administracion">
                                    Usuarios
                                </a>
                            </li>
                        }

                        @if (User.IsInRole("Usuario Premium"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-black" asp-controller="Home" asp-action="Reportes">
                                    Reportes y Metas
                                </a>
                            </li>
                        }
                    </ul>
                }
            </div>

            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="border-top border-secondary pt-3 mt-3 px-1">
                    <div class="d-flex flex-column gap-2">
                        <div class="lh-sm">
                            <div class="fw-semibold text-light text-truncate">@User.Identity.Name</div>
                            <small class="text-muted" style="font-size: 0.8rem;">
                                @User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value
                            </small>
                        </div>
                        <form asp-controller="Cuenta" asp-action="Logout" method="post" class="m-0">
                            @Html.AntiForgeryToken()
                            <button class="btn btn-outline-danger btn-sm w-100 mt-1" type="submit">
                                Cerrar sesión
                            </button>
                        </form>
                    </div>
                </div>
            }
        </aside>

        <div class="d-flex flex-column flex-grow-1 bg-light">
            <main role="main" class="flex-grow-1 p-4 p-md-5">
                @RenderBody()
            </main>

            <footer class="border-top bg-white text-muted p-3">
                <div class="container-fluid text-center text-md-start">
                    &copy; 2026 - Midas - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacidad</a>
                </div>
            </footer>
        </div>
    </div>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <script src="~/js/idle-timeout.js" asp-append-version="true"></script>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>